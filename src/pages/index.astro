.upstream td:nth-child(2) { color: var(--muted); font-size: 15px; }
.upstream td.n { font-family: var(--mono); font-size: 13px; color: var(--muted); text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; padding-right: 6px; }

/* archive */
.archive { list-style: none; padding: 0; margin: 0; }
.archive li { display: grid; grid-template-columns: 64px minmax(0, 200px) minmax(0, 1fr) auto; gap: 18px; padding-block: 14px; border-top: 1px solid var(--rule); align-items: baseline; }
.archive li:last-child { border-bottom: 1px solid var(--rule); }
.archive .yr { font-family: var(--display); font-weight: 800; font-size: 22px; line-height: 1; color: var(--c-grey); font-variant-numeric: tabular-nums; }
