---
import Workspace from './Workspace.astro';
import Window from './Window.astro';
import { friends, upstream, friendHref } from '../data/projects';
import { friendLabel, loadContributions, upstreamRows } from '../scripts/contributions';

async function buildContributions() {
  try {
    return await loadContributions();
  } catch (err) {
    console.warn(`contributions: could not reach GitHub (${err}), using the counts in projects.ts`);
    return { friends, upstream };
  }
}

const latest = await buildContributions();
const fmt = (n: number) => n.toLocaleString('en-US');
---

<Workspace id="contributions">
  <Window kind="notes" title="friends.md">
    <h2>Other people's code</h2>
    <p class="lede">Friends' projects I contribute to, and patches sent upstream.</p>
    <div class="friends">
      {
        latest.friends.map((f) => (
          <a class="friend" href={friendHref(f)} target="_blank" rel="noopener" data-repo={f.repo}>
            <b data-count={f.count}>{fmt(f.count)}</b>
            <small>{friendLabel(f)}</small>
            <span>{f.name}</span>
          </a>
        ))
      }
    </div>
  </Window>
  <Window kind="files" title="~/upstream">
    <div class="main">
      <h3>Sent upstream</h3>
      <ul class="rows cols upstream" set:html={upstreamRows(latest.upstream.length ? latest.upstream : upstream)} />
    </div>
  </Window>
</Workspace>

<script>
  import { loadContributions, showContributions } from '../scripts/contributions';

  loadContributions()
    .then((latest) => showContributions(document.getElementById('contributions')!, latest))
    .catch(() => {});
</script>
