---
import Workspace from './Workspace.astro';
import Window from './Window.astro';
import Fetch from './Fetch.astro';
import Shell from './Shell.astro';
import { elsewhere } from '../data/projects';
import { workspaces, colorVar, keyOf } from '../data/desktop';

const others = workspaces.slice(1);
---

<Workspace id="about">
  <Window kind="notes" title="hello.md" class="hello">
    <h1><span>Arzaroth</span></h1>
    <p>I started in DevOps and ended up a CISO. I still write plenty of code, and most of it runs on my own machines.</p>
    <p>I self-host whatever I can. That's part of why there's a 42U rack in my living room.</p>
    <div class="elsewhere">
      {
        elsewhere.map((l) => (
          <a href={l.href} target="_blank" rel="noopener">
            {l.label}
            <span>{l.detail}</span>
          </a>
        ))
      }
    </div>
    <p class="hint">
      Each workspace up top holds one part of the work. Scroll, or press <kbd>j</kbd> and <kbd>k</kbd>, to open its windows
      one by one and carry on to the next. Hold <kbd>ctrl</kbd> and press <kbd>1</kbd> to <kbd>0</kbd> to jump straight to one.
      The window under the pointer has the focus, and terminals take what you type.
    </p>
  </Window>
  <Window kind="term" title="fastfetch">
    <Shell name="fastfetch" ran="fastfetch" hint="fastfetch">
      <Fetch />
      <template slot="templates" data-cmd="fastfetch"><Fetch /></template>
    </Shell>
  </Window>
  <Window kind="files" title="~/workspaces">
    <nav class="side" aria-hidden="true">
      <div>home</div>
      <div class="here" style="--c:var(--peach)">workspaces</div>
      <div>rack</div>
    </nav>
    <div class="main">
      <ul class="rows">
        {
          others.map((w, i) => (
            <li>
              <button class="row" type="button" data-go={w.id} style={`--c:${colorVar(w.color)}`}>
                <span class="fi" />
                <span class="nm">{w.label[0].toUpperCase() + w.label.slice(1)}</span>
                <span class="dt">{keyOf(i + 1)}</span>
                <span class="ds">{w.blurb}</span>
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </Window>
</Workspace>
