---
import Pane from './Pane.astro';
import { friends, upstream } from '../data/projects';
---

<Pane id="contributions" title="Other people's code" lede="Friends' projects I contribute to, and patches sent upstream.">
  <div class="friends">
    {
      friends.map((f, i) => (
        <article class="entry rv" style={`--k:${3 + i}`}>
          <div class="count">
            <span data-count={f.count}>{f.count}</span>
            <small>{f.unit}</small>
          </div>
          <h3>{f.name}</h3>
          <div class="meta">{f.when}</div>
          <div class="links">
            <a href={f.href} target="_blank" rel="noopener">
              My {f.unit}
            </a>
          </div>
        </article>
      ))
    }
  </div>
  <div class="upstream-wrap rv" style="--k:6">
    <table class="upstream">
      <caption>Sent upstream</caption>
      <tbody>
        {
          upstream.map((u) => (
            <tr>
              <td>
                <a href={u.href} target="_blank" rel="noopener">
                  {u.name}
                </a>
              </td>
              <td class="n">{u.when}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Pane>
