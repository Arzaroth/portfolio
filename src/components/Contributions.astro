---
import Workspace from './Workspace.astro';
import Window from './Window.astro';
import { friends, upstream } from '../data/projects';
---

<Workspace id="contributions">
  <Window kind="notes" title="friends.md">
    <h2>Other people's code</h2>
    <p class="lede">Friends' projects I contribute to, and patches sent upstream.</p>
    <div class="friends">
      {
        friends.map((f) => (
          <a class="friend" href={f.href} target="_blank" rel="noopener">
            <b data-count={f.count}>{f.count}</b>
            <small>
              {f.unit}, {f.when}
            </small>
            <span>{f.name}</span>
          </a>
        ))
      }
    </div>
  </Window>
  <Window kind="files" title="~/upstream">
    <div class="main">
      <h3>Sent upstream</h3>
      <ul class="rows cols">
        {
          upstream.map((u) => (
            <li class="row" style="--c:var(--clay)">
              <span class="fi" />
              <span class="nm">
                <a href={u.href} target="_blank" rel="noopener">{u.name}</a>
              </span>
              <span class="dt">{u.when}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Window>
</Workspace>
