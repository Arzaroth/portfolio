---
import { fetchRows } from '../data/demos';
import { workspaces, colorVar } from '../data/desktop';

const leds = ['peach', 'sky', 'gold', 'lav', 'sage', 'rose', 'teal', 'clay'];
---

<div class="fetch">
  <svg viewBox="0 0 60 92" aria-hidden="true">
    <rect x="2" y="2" width="56" height="88" rx="5" fill="none" stroke="var(--dim)" stroke-width="2"></rect>
    {
      leds.map((c, n) => (
        <>
          <rect x="8" y={8 + n * 10} width="44" height="7" rx="1.5" fill={`var(--${c})`} opacity=".85" />
          <circle cx="46" cy={11.5 + n * 10} r="1.4" fill="var(--win-solid)" />
        </>
      ))
    }
  </svg>
  <dl>
    {
      fetchRows.map(([k, v]) => (
        <>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </>
      ))
    }
  </dl>
</div>
<div class="swatches" aria-hidden="true">
  {workspaces.slice(0, 8).map((w) => <i style={`background:${colorVar(w.color)}`} />)}
</div>
