---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  k: number;
  class?: string;
}

const { project, k, class: extra } = Astro.props;
---

<article class:list={['entry', 'rv', extra]} style={`--k:${k}`}>
  <slot name="before" />
  <h3>{project.name}</h3>
  <p>{project.description}</p>
  {project.meta && <div class="meta">{project.meta}</div>}
  <div class="links">
    {
      project.links?.map((l) => (
        <a href={l.href} target="_blank" rel="noopener">
          {l.label}
        </a>
      ))
    }
    {project.wip && <span class="wip">In progress</span>}
  </div>
</article>
