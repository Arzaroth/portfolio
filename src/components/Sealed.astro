---
import Pane from './Pane.astro';
import { sealed } from '../data/projects';
---

<Pane
  id="sealed"
  title="Under wraps"
  lede="Racked and cabled, with the blanking panel still on. For now the names are all there is to know."
>
  <div class="entries">
    {
      sealed.map((name, i) => (
        <article class="entry rv" style={`--k:${3 + i}`}>
          <h3>{name}</h3>
          <div class="redacted" role="img" aria-label="Details withheld">
            <i style="--w:94%" />
            <i style="--w:81%" />
            <i style="--w:58%" />
          </div>
          <div class="links">
            <span class="classified">Classified</span>
          </div>
        </article>
      ))
    }
  </div>
</Pane>
