<script is:inline>
(function () {
  var bay = document.getElementById('bay');
  var side = document.getElementById('side');
  var stage = document.getElementById('stage');
  var devs = Array.prototype.slice.call(document.querySelectorAll('.dev'));
  var panes = Array.prototype.slice.call(document.querySelectorAll('.pane'));
  var order = devs.map(function (d) { return d.dataset.to; });
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var narrow = window.matchMedia('(max-width: 959px)');
  var zone = document.querySelector('.rack-zone'), bar = document.getElementById('patchbar'), wires = document.getElementById('wires');
  var NS = 'http://www.w3.org/2000/svg', wireset = [], plugged = false;
  var current = null;

  var frag = document.createDocumentFragment();
  for (var row = 1; row <= 42; row++) {
    ['un', 'un r'].forEach(function (cls) {
      var s = document.createElement('span');
      s.className = cls; s.style.gridRow = row; s.setAttribute('aria-hidden', 'true');
      s.textContent = 43 - row;
      frag.appendChild(s);
    });
  }
  bay.appendChild(frag);

  panes.forEach(function (p, i) {
    var nextId = order[(order.indexOf(p.id) + 1) % order.length];
    var nextDev = devs[order.indexOf(nextId)];
    var nav = document.createElement('div');
    nav.className = 'next';
    var b = document.createElement('button');
    b.dataset.go = nextId;
    b.style.setProperty('--nc', nextDev.style.getPropertyValue('--c'));
    b.innerHTML = '<small>Next server</small>' + nextDev.firstChild.nextSibling.textContent.trim() + ' <span aria-hidden="true">&#8595;</span>';
    nav.appendChild(b);
    p.appendChild(nav);
  });

  function colorOf(el) { return getComputedStyle(el).getPropertyValue('--c').trim() || '#888'; }

  function countUp(el) {
    var to = +el.dataset.count;
    if (reduce) { el.textContent = to.toLocaleString('en-US'); return; }
    var t0 = null, dur = to > 100 ? 1800 : 900;
    function step(t) {
      if (!t0) t0 = t;
      var k = Math.min(1, (t - t0) / dur);
      var e = 1 - Math.pow(1 - k, 4);
      el.textContent = Math.round((to > 100 ? 8 : 0) + (to - (to > 100 ? 8 : 0)) * e).toLocaleString('en-US');
      if (k < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  devs.forEach(function (d, i) {
    var port = document.createElement('span');
    port.className = 'pport';
    port.style.setProperty('--pc', d.style.getPropertyValue('--c'));
    bar.appendChild(port);
    var g = { shade: document.createElementNS(NS, 'path'), w: document.createElementNS(NS, 'path'), pk: document.createElementNS(NS, 'path'), port: port, dev: d };
    g.shade.setAttribute('class', 'shade'); g.w.setAttribute('class', 'w'); g.pk.setAttribute('class', 'pk');
    g.w.style.stroke = d.style.getPropertyValue('--c');
    g.w.style.setProperty('--dl', (1.5 + i * 0.12) + 's');
    wires.appendChild(g.shade); wires.appendChild(g.w); wires.appendChild(g.pk);
    wireset.push(g);
  });

  function layoutWires() {
    if (narrow.matches) return;
    var rk = zone.querySelector('.rack');
    bar.style.height = rk.offsetHeight + 'px';
    var z = zone.getBoundingClientRect(), b = bar.getBoundingClientRect();
    wireset.forEach(function (g) {
      var p = g.dev.querySelector('.ports i:last-child').getBoundingClientRect();
      var sx = p.left + p.width / 2 - z.left, sy = p.top + p.height / 2 - z.top;
      var ex = b.left + b.width / 2 - z.left, ey = sy;
      g.port.style.top = (sy - (b.top - z.top)) + 'px';
      var droop = 16 + Math.min(10, g.dev.offsetHeight * 0.2);
      var d = 'M' + sx + ' ' + sy + ' C' + (sx + 6) + ' ' + (sy + droop) + ', ' + (ex - 6) + ' ' + (ey + droop) + ', ' + ex + ' ' + ey;
      g.shade.setAttribute('d', d); g.w.setAttribute('d', d);
      g.pk.setAttribute('d', g.dev.classList.contains('on') ? d : '');
    });
    var on = devs[order.indexOf(current)];
    if (on) {
      var r = on.getBoundingClientRect(), sr = side.getBoundingClientRect();
      side.style.setProperty('--gy', (((r.top + r.height / 2) - sr.top) / sr.height * 100).toFixed(1) + '%');
    }
  }

  function plugIn() {
    if (plugged || reduce) return;
    plugged = true;
    wireset.forEach(function (g) { g.w.classList.add('plug'); g.shade.style.opacity = 0; });
    setTimeout(function () { wireset.forEach(function (g) { g.shade.style.transition = 'opacity .4s'; g.shade.style.opacity = ''; }); }, 2600);
  }

  function show(id, opts) {
    opts = opts || {};
    if (order.indexOf(id) < 0) id = 'about';
    if (id === current) return;
    var prev = current ? document.getElementById(current) : null;
    var next = document.getElementById(id);
    current = id;
    devs.forEach(function (d) {
      var on = d.dataset.to === id;
      d.classList.toggle('on', on);
      if (on) d.setAttribute('aria-current', 'page'); else d.removeAttribute('aria-current');
    });
    side.style.setProperty('--glow', colorOf(next));
    function swap() {
      panes.forEach(function (p) { p.hidden = p !== next; p.classList.remove('leaving'); });
      next.querySelectorAll('[data-count]').forEach(countUp);
      if (window.scrollY > stage.offsetTop) window.scrollTo({ top: narrow.matches ? stage.offsetTop - 60 : 0, behavior: reduce ? 'auto' : 'smooth' });
      if (opts.focus) { next.setAttribute('tabindex', '-1'); next.focus({ preventScroll: true }); }
      wireset.forEach(function (g) { var on = g.dev.dataset.to === id; g.w.classList.toggle('on', on); g.port.classList.toggle('on', on); });
      layoutWires();
      if (narrow.matches) { var d = devs[order.indexOf(id)]; d.scrollIntoView({ inline: 'center', block: 'nearest', behavior: reduce ? 'auto' : 'smooth' }); }
    }
    if (prev && !reduce) { prev.classList.add('leaving'); setTimeout(swap, 160); } else swap();
    try { history.replaceState(null, '', '#' + id); } catch (e) {}
  }

  devs.forEach(function (d) {
    d.addEventListener('click', function (e) { e.preventDefault(); show(d.dataset.to, { focus: false }); });
    d.addEventListener('keydown', function (e) {
      var i = order.indexOf(d.dataset.to);
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        var n = devs[(i + (e.key === 'ArrowDown' ? 1 : order.length - 1)) % order.length];
        n.focus(); show(n.dataset.to);
      }
    });
  });
  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-go]');
    if (b) { e.preventDefault(); show(b.dataset.go, { focus: true }); }
  });
  document.addEventListener('keydown', function (e) {
    if (e.metaKey || e.ctrlKey || e.altKey || /input|textarea|select/i.test(e.target.tagName)) return;
    var i = order.indexOf(current);
    if (e.key === 'j') show(order[(i + 1) % order.length]);
    if (e.key === 'k') show(order[(i + order.length - 1) % order.length]);
  });
  window.addEventListener('resize', layoutWires);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(layoutWires);
  window.addEventListener('hashchange', function () { show(location.hash.slice(1)); });

  plugIn();
  show(location.hash.slice(1) || 'about', { initial: true });
  setTimeout(layoutWires, 1200);
  requestAnimationFrame(function () { window.scrollTo(0, 0); });
  window.addEventListener('load', function () { window.scrollTo(0, 0); layoutWires(); });
})();
</script>
