---
import { RACK_UNITS, servers, colorVar, unitLabel, gridRow } from '../data/servers';

const rows = Array.from({ length: RACK_UNITS }, (_, i) => i + 1);
---

<aside class="side" id="side">
  <div class="brand"><b>Arzaroth</b></div>
  <div class="rack-zone">
    <nav class="rack" aria-label="Sections">
      <div class="rack-top"><span class="pwr"><i></i>Bay A</span><b>{RACK_UNITS}U</b></div>
      <div class="bay">
        <div class="rail" aria-hidden="true"></div>
        {
          rows.flatMap((row) =>
            ['un', 'un r'].map((cls) => (
              <span class={cls} style={`grid-row:${row}`} aria-hidden="true">
                {RACK_UNITS + 1 - row}
              </span>
            )),
          )
        }
        {
          servers.map((s, i) => (
            <a
              class="dev"
              href={`#${s.id}`}
              data-to={s.id}
              style={`--r:${gridRow(s)}; --c:${colorVar(s.color)}; --i:${i}${s.oldLed ? '; --ledc:var(--led-old)' : ''}`}
            >
              <span class="led" />
              {s.name} <small>{unitLabel(s)}</small>
              <span class="ports">
                {Array.from({ length: s.ports }, () => (
                  <i />
                ))}
              </span>
            </a>
          ))
        }
      </div>
    </nav>
    <div class="patchbar" aria-hidden="true">
      {servers.map((s) => <span class="pport" data-to={s.id} style={`--pc:${colorVar(s.color)}`} />)}
    </div>
    <svg class="wires" aria-hidden="true">
      {
        servers.map((s, i) => (
          <g data-to={s.id}>
            <path class="shade" />
            <path class="w" style={`stroke:${colorVar(s.color)}; --dl:${(1.5 + i * 0.12).toFixed(2)}s`} />
            <path class="pk" />
          </g>
        ))
      }
    </svg>
  </div>
  <div class="side-foot">
    <span><kbd>J</kbd> <kbd>K</kbd> to switch server</span>
    <a href="https://github.com/Arzaroth" target="_blank" rel="noopener">GitHub</a>
  </div>
</aside>

<script>
  import { initRack } from '../scripts/rack';
  initRack();
</script>
