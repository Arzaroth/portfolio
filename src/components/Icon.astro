---
interface Props {
  name: 'back' | 'fwd' | 'lock' | 'term' | 'folder' | 'note' | 'swap' | 'arrow' | 'arch' | 'sep';
}

const { name } = Astro.props;
const line = { fill: 'none', stroke: 'currentColor', 'stroke-width': 1.6, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---

{name === 'back' && <svg class="ico" viewBox="0 0 16 16" aria-hidden="true" {...line}><path d="M10 3 5 8l5 5" /></svg>}
{name === 'fwd' && <svg class="ico" viewBox="0 0 16 16" aria-hidden="true" {...line}><path d="m6 3 5 5-5 5" /></svg>}
{
  name === 'lock' && (
    <svg class="ico" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
      <rect x="3" y="7" width="10" height="7" rx="1.5" />
      <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" />
    </svg>
  )
}
{name === 'term' && <svg class="ico" viewBox="0 0 16 16" aria-hidden="true" {...line}><path d="m3 4 4 4-4 4M8.5 12H13" /></svg>}
{
  name === 'folder' && (
    <svg class="ico" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
      <path d="M2 4.5c0-.8.7-1.5 1.5-1.5h3l1.5 1.5h4.5c.8 0 1.5.7 1.5 1.5v5.5c0 .8-.7 1.5-1.5 1.5h-9C2.7 13 2 12.3 2 11.5Z" />
    </svg>
  )
}
{
  name === 'note' && (
    <svg class="ico" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <rect x="3" y="2" width="10" height="12" rx="2" />
      <path d="M5.5 5.5h5M5.5 8h5M5.5 10.5h3" />
    </svg>
  )
}
{
  name === 'swap' && (
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
      <rect x="2" y="2.5" width="6" height="11" rx="1.5" />
      <rect x="10" y="2.5" width="4" height="5" rx="1" />
      <rect x="10" y="9.5" width="4" height="4" rx="1" />
    </svg>
  )
}
{name === 'arrow' && <svg class="arrow" viewBox="0 0 42 20" aria-hidden="true" {...line}><path d="M2 10h36m-6-6 6 6-6 6" /></svg>}
{
  name === 'arch' && (
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path d="M8 1c-.6 1.6-1 2.6-1.7 4.1.4.4 1 .9 1.9 1.5-1-.4-1.6-.8-2.1-1.2C5.1 7.3 3.6 9.9 1.3 14c1.7-1 3-1.6 4.3-1.8a3 3 0 0 1-.1-.9c0-1.3.9-2.3 2.4-2.3s2.3 1.1 2.3 2.4c0 .3 0 .6-.1.8 1.3.2 2.6.8 4.3 1.8l-1-1.8c-.6-.5-1.3-1-2.6-1.7.9.2 1.6.5 2.1.8C11.7 8 10.3 5.5 8 1Z" />
    </svg>
  )
}
{name === 'sep' && <svg class="sep" viewBox="0 0 7 22" aria-hidden="true"><path d="M1 3l5 8-5 8" fill="none" stroke="currentColor" stroke-width="1.2" /></svg>}
