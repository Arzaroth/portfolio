---
import Workspace from './Workspace.astro';
import Window from './Window.astro';
import Project from './Project.astro';
import Shell from './Shell.astro';
import { services, infrastructure, lumen } from '../data/projects';
import { demos } from '../data/demos';

const [deb, forgejo, dotfiles] = infrastructure;
const roles = { plumbing: ['teal', 'Plumbing'], watch: ['rose', 'Keeping watch'], app: ['sky', 'My apps'] } as const;
const host = (href: string) => href.replace('https://', '');
---

<Workspace id="selfhosted">
  <Window kind="files" title="/srv on the rack">
    <nav class="side" aria-hidden="true">
      <div>home</div>
      <div class="here" style="--c:var(--teal)">srv</div>
      <div style="--c:var(--rose)">backups</div>
    </nav>
    <div class="main">
      <h2>Self-hosted, by stubbornness</h2>
      <p class="lede">
        If it can run at home, it runs at home. Every app on this site runs on the rack, next to the photos, passwords and
        documents the household uses every day.
      </p>
      <div class="legend">
        {Object.entries(roles).map(([role, [c, name]]) => <span data-role={role} style={`--c:var(--${c})`}>{name}</span>)}
      </div>
      <ul class="icons">
        {
          services.map(([name, role]) => (
            <li class="svc" data-role={role} style={`--c:var(--${roles[role][0]})`}>
              <i />
              {name}
            </li>
          ))
        }
      </ul>
    </div>
  </Window>
  <Window kind="browser" title={deb.name} href={deb.links![0].href} host={host(deb.links![0].href)}>
    <svg slot="hero" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
      <path d="M32 6 56 18v28L32 58 8 46V18Z"></path>
      <path d="M8 18l24 12 24-12M32 30v28"></path>
      <path d="m20 12 24 12v10" stroke-width="1.6" opacity=".6"></path>
      <path d="M14 38v4l8 4v-4Z" fill="currentColor" stroke="none" opacity=".7"></path>
    </svg>
    <Project project={deb} />
  </Window>
  <Window kind="browser" title="Forgejo" href={forgejo.links![0].href} host={host(forgejo.links![0].href)}>
    <Project project={forgejo} />
  </Window>
  <Window kind="term" title="dotfiles">
    <Shell name="dotfiles" path="~/dotfiles" ran="stow */" hint="stow" demos={demos.dotfiles}>
      <Project project={dotfiles} />
    </Shell>
  </Window>
  <Window kind="browser" title={lumen.name} href={lumen.links![0].href} host={host(lumen.links![0].href)}>
    <svg slot="hero" viewBox="0 0 80 60" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
      <rect x="4" y="4" width="72" height="42" rx="4"></rect>
      <path d="M30 56h20M40 46v10"></path>
      <path d="m40 14 2.4 6.6 7 .3-5.5 4.3 1.9 6.8-5.8-3.9-5.8 3.9 1.9-6.8-5.5-4.3 7-.3Z" fill="currentColor" stroke="none"></path>
    </svg>
    <Project project={lumen} />
  </Window>
</Workspace>
