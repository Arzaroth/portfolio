---
import Workspace from './Workspace.astro';
import Window from './Window.astro';
import Panel from './Panel.astro';
import Icon from './Icon.astro';
import { recomp } from '../data/projects';

const host = (href: string) => href.replace('https://', '');
---

<Workspace id="recomp">
  <Window kind="notes" title="the-bozos.md" class="recomp">
    <h2>PS2, recompiled</h2>
    <p>{recomp.lede}</p>
    <p class="lede">
      I make them with boubou as{' '}
      <a href={recomp.group.href} target="_blank" rel="noopener">{recomp.group.name}</a>. Our own engine is{' '}
      <a href={recomp.engine.href} target="_blank" rel="noopener">{recomp.engine.name}</a>, a static recompiler and a
      runtime that answers the game's calls natively, with no PS2 hardware at any level. Champions of Norrath already
      runs on it, and the other games are moving over.
    </p>
    <h3 class="ports-title">My games</h3>
    <ul class="ports">
      {
        recomp.ports.map((p) => (
          <li>
            <a href={p.href} target="_blank" rel="noopener">{p.name}</a>
            <code>{p.disc}</code>
            <span class:list={['status', { ok: p.status === 'Playable' }]}>{p.status}</span>
          </li>
        ))
      }
    </ul>
    <div class="links">
      <a class="btn" href={recomp.watcher.href} target="_blank" rel="noopener">Every port on {recomp.watcher.name}</a>
    </div>
    <div class="spin" aria-hidden="true">
      <svg viewBox="0 0 64 64">
        <circle cx="32" cy="32" r="29" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
        <circle cx="32" cy="32" r="22" fill="none" stroke="currentColor" stroke-width=".5" opacity=".35"></circle>
        <circle cx="32" cy="32" r="15" fill="none" stroke="currentColor" stroke-width=".5" opacity=".35"></circle>
        <circle cx="32" cy="32" r="7" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
        <path d="M32 6a26 26 0 0 1 24 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity=".6"></path>
      </svg>
    </div>
  </Window>
  <Window kind="browser" title="ps2 ports" tabs={recomp.ports.map((p) => p.tab)} flush big>
    {
      recomp.ports.map((p) => (
        <Panel win="ps2 ports" tab={p.tab}>
          <div class="addr">
            <a class="url" href={p.href} target="_blank" rel="noopener" tabindex="-1">
              <Icon name="lock" />
              {host(p.href)}
            </a>
          </div>
          <div class="hero" aria-hidden="true">
            <div class="disc">
              <svg viewBox="0 0 64 64">
                <circle cx="32" cy="32" r="29" fill="none" stroke="currentColor" stroke-width="2" />
                <circle cx="32" cy="32" r="7" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="M32 9a23 23 0 0 1 21 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".5" />
              </svg>
              <code>{p.disc}</code>
            </div>
          </div>
          <div class="pg">
            <span class:list={['status', { ok: p.status === 'Playable' }]}>{p.status}</span>
            <h2>{p.name}</h2>
            <p>{p.description}</p>
            <div class="tags">
              {p.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
            <div class="links">
              <a class="btn" href={p.href} target="_blank" rel="noopener">Source</a>
            </div>
          </div>
        </Panel>
      ))
    }
  </Window>
</Workspace>
