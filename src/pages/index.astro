    <button class="rv" style="--k:9; --c:var(--c-green)" data-go="workshop"><b>Workbench</b><small>Tacite, Pouce Vert, Sheaf</small></button>
    <button class="rv" style="--k:10; --c:var(--c-red)" data-go="ouroboros"><b>ouroboros</b><small>Eight lines of Python that kept growing</small></button>
