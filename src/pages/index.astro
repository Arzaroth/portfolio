<!-- HELLO -->
<section class="pane" id="about" style="--c:var(--c-cyan)">
  <div class="pane-head">
    <div class="slot">U41-42</div>
    <h1 class="hello-name" aria-label="Arzaroth"><span style="--n:0">A</span><span style="--n:1">r</span><span style="--n:2">z</span><span style="--n:3">a</span><span style="--n:4">r</span><span style="--n:5">o</span><span style="--n:6">t</span><span style="--n:7">h</span></h1>
    <div class="intro">
      <p class="rv" style="--k:4">I started in DevOps and ended up a CISO. I still write plenty of code, and most of it runs on my own machines.</p>
      <p class="rv" style="--k:5">I self-host whatever I can. That's part of why there's a 42U rack in my living room.</p>
    </div>
    <div class="elsewhere rv" style="--k:6">
      <a href="https://github.com/Arzaroth" target="_blank" rel="noopener">GitHub<span>@Arzaroth</span></a>
      <a href="https://git.arzaroth.com/Arzaroth" target="_blank" rel="noopener">Forgejo<span>git.arzaroth.com</span></a>
      <a href="https://deb.arzaroth.com" target="_blank" rel="noopener">APT repository<span>deb.arzaroth.com</span></a>
    </div>
  </div>
  <div class="index">
    <button class="rv" style="--k:7; --c:var(--c-blue)" data-go="apps"><b>Apps</b><small>Nostragoalus, La Coincherie, Yaek, c2c-conv</small></button>
