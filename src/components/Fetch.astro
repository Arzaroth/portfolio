---
import { fetchRows } from '../data/demos';
import { workspaces, colorVar } from '../data/desktop';

const height = 12 + workspaces.length * 10;
---

<div class="fetch">
  <svg viewBox={`0 0 60 ${height}`} aria-hidden="true">
    <rect x="2" y="2" width="56" height={height - 4} rx="5" fill="none" stroke="var(--dim)" stroke-width="2"></rect>
    {
      workspaces.map((w, n) => (
        <>
          <rect x="8" y={8 + n * 10} width="44" height="7" rx="1.5" fill={colorVar(w.color)} opacity=".85" />
          <circle cx="46" cy={11.5 + n * 10} r="1.4" fill="var(--win-solid)" />
        </>
      ))
    }
  </svg>
  <dl>
    {
      fetchRows.map(([k, v]) => (
        <>
          <dt>{k}</dt>
          <dd>{v}</dd>
        </>
      ))
    }
  </dl>
</div>
<div class="swatches" aria-hidden="true">
  {workspaces.map((w) => <i style={`background:${colorVar(w.color)}`} />)}
</div>
