---
import { byId, colorVar, nextOf, unitLabel } from '../data/servers';

interface Props {
  id: string;
  title?: string;
  lede?: string;
}

const { id, title, lede } = Astro.props;
const server = byId(id);
const next = nextOf(id);
const custom = Astro.slots.has('head');
---

<section class="pane" id={id} style={`--c:${colorVar(server.color)}`}>
  <div class="pane-head">
    <div class:list={['slot', { rv: !custom }]} style="--k:0">{unitLabel(server)}</div>
    {
      custom ? (
        <slot name="head" />
      ) : (
        <>
          {title && <h2 class="rv" style="--k:1">{title}</h2>}
          {lede && <p class="lede rv" style="--k:2">{lede}</p>}
        </>
      )
    }
  </div>
  <slot />
  <div class="next">
    <button data-go={next.id} style={`--nc:${colorVar(next.color)}`}>
      <small>Next server</small>{next.name} <span aria-hidden="true">&#8595;</span>
    </button>
  </div>
</section>
