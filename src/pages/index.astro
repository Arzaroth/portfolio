---
import Base from '../layouts/Base.astro';
import Rack from '../components/Rack.astro';
import Pane from '../components/Pane.astro';
import Entry from '../components/Entry.astro';
import Hello from '../components/Hello.astro';
import Gauges from '../components/Gauges.astro';
import Ouroboros from '../components/Ouroboros.astro';
import SelfHosting from '../components/SelfHosting.astro';
import Contributions from '../components/Contributions.astro';
import EarlyYears from '../components/EarlyYears.astro';
import { apps, workbench } from '../data/projects';
---

<Base>
  <div class="app">
    <Rack />
    <main class="stage" id="stage">
      <Hello />
      <Pane id="apps" title="Apps people actually use" lede="Built for friends first, then opened up. Each one runs on the rack, or on your phone.">
        <div class="entries">
          {apps.map((p, i) => <Entry project={p} k={3 + i} />)}
        </div>
      </Pane>
      <Gauges />
      <Pane id="workshop" title="On the workbench" lede="Not public yet. They will be when they are ready.">
        <div class="entries">
          {workbench.map((p, i) => <Entry project={p} k={3 + i} />)}
        </div>
      </Pane>
      <Ouroboros />
      <SelfHosting />
      <Contributions />
      <EarlyYears />
    </main>
  </div>
</Base>
