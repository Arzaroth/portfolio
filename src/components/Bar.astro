---
import { workspaces, colorVar } from '../data/desktop';
---

<header class="bar">
  <a class="logo" href="#about" aria-label="Arzaroth, home">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <defs>
        <linearGradient id="logo-tint" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f3a46f"></stop>
          <stop offset=".55" stop-color="#ec8ba1"></stop>
          <stop offset="1" stop-color="#b7a0f4"></stop>
        </linearGradient>
      </defs>
      <path d="M12 2.5 21.5 21h-4.2L12 10.4 6.7 21H2.5Z" fill="url(#logo-tint)"></path>
      <path d="M9.2 16.5h5.6" stroke="#1c1730" stroke-width="2"></path>
    </svg>
  </a>
  <nav class="ws-list" aria-label="Workspaces">
    {
      workspaces.map((w, i) => (
        <a class="ws-btn" href={`#${w.id}`} data-go={w.id} style={`--c:${colorVar(w.color)}`} aria-label={`Workspace ${i + 1}, ${w.label}`}>
          <i>{i + 1}</i>
          <span>{w.label}</span>
        </a>
      ))
    }
  </nav>
  <div class="bar-title" aria-live="polite"></div>
  <div class="bar-right">
    <div class="keys" aria-hidden="true">
      <span><kbd>1-9</kbd>workspace</span>
      <span><kbd>hjkl</kbd>focus</span>
      <span><kbd>m</kbd>swap to master</span>
    </div>
    <span class="clock"></span>
  </div>
</header>
