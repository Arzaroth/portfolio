---
import Workspace from './Workspace.astro';
import Window from './Window.astro';
import Panel from './Panel.astro';
import Shell from './Shell.astro';
import Project from './Project.astro';
import { gauges, selvedge, codegauge, smith, wyrmyon } from '../data/projects';
import { demos } from '../data/demos';

const forgejo = codegauge.links![0].href;
const shells = [
  ...gauges.map((g) => ({ project: g, path: `~/src/${g.name}`, ran: g.name.toLowerCase(), hint: g.name.toLowerCase(), demos: demos[g.name.toLowerCase()] })),
  { project: smith, path: '~/src/portfolio', ran: 'smith pr list', hint: 'smith', demos: demos.smith },
  { project: wyrmyon, path: '~/src/wyrmyon', ran: 'wyrm report.pdf', hint: 'wyrm', demos: demos.wyrmyon },
];
---

<Workspace id="gauges">
  <Window kind="term" title="toolbox" tabs={shells.map((s) => s.project.name)} big>
    {
      shells.map((s) => (
        <Panel win="toolbox" tab={s.project.name}>
          <Shell name={s.project.name} path={s.path} ran={s.ran} hint={s.hint} demos={s.demos}>
            <Project project={s.project} big />
          </Shell>
        </Panel>
      ))
    }
  </Window>
  <Window kind="notes" title="selvedge.md">
    <h3>selvedge</h3>
    <p class="lede">Three Rust binaries, unrelated, that install and update themselves the same way.</p>
    <p>{selvedge.description}</p>
    <ul class="duties">{selvedge.duties.map((d) => <li>{d}</li>)}</ul>
    <p class="was">Was <s>{selvedge.saved}</s> in each gauge.</p>
    <div class="links"><a class="btn" href={selvedge.href} target="_blank" rel="noopener">Source</a></div>
  </Window>
  <Window kind="browser" title={codegauge.name} href={forgejo} host={forgejo.replace('https://', '')}>
    <Project project={codegauge} />
  </Window>
</Workspace>
