---
import Pane from './Pane.astro';
import { ouroboros } from '../data/projects';
import { latestLines } from '../scripts/ouroboros';

const fmt = (n: number) => n.toLocaleString('en-US');

async function buildLines() {
  try {
    const lines = await latestLines();
    if (lines === undefined) throw new Error('no LOC line in the release notes');
    return lines;
  } catch (err) {
    console.warn(`ouroboros: could not read the latest release (${err}), using ${ouroboros.lastKnownLines}`);
    return ouroboros.lastKnownLines;
  }
}

const lines = await buildLines();
---

<Pane id="ouroboros" title="ouroboros">
  <div class="ouro rv" style="--k:2">
    <svg class="snake" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="26"></circle></svg>
    <p class="lede">{ouroboros.lede}</p>
    <div class="scale" aria-label="Lines of code, drawn to scale">
      <div class="scale-row">
        <div><b>{ouroboros.firstLines}</b><span>first commit</span></div>
        <div class="bar tiny"></div>
      </div>
      <div class="scale-row">
        <div>
          <b data-count={lines} data-from={ouroboros.firstLines}>{fmt(lines)}</b><span>today, one file</span>
        </div>
        <div class="bar full"></div>
      </div>
    </div>
    <ol class="tiers">
      {
        ouroboros.tiers.map(([name, text], i) => (
          <li class="rv" style={`--k:${4 + i}`}>
            <b>{name}</b>
            {text}
          </li>
        ))
      }
    </ol>
    <div class="ouro-foot">
      <p>A differential fuzzer checks that every tier agrees.</p>
      <a href={ouroboros.href} target="_blank" rel="noopener">Read all <span data-lines>{fmt(lines)}</span> lines</a>
    </div>
  </div>
</Pane>

<script>
  import { latestLines, showLines } from '../scripts/ouroboros';

  latestLines()
    .then((lines) => lines && showLines(document.getElementById('ouroboros')!, lines))
    .catch(() => {});
</script>
