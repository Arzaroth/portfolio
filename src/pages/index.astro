---
import Base from '../layouts/Base.astro';
import Wall from '../components/Wall.astro';
import Bar from '../components/Bar.astro';
import Hello from '../components/Hello.astro';
import Apps from '../components/Apps.astro';
import Gauges from '../components/Gauges.astro';
import Tools from '../components/Tools.astro';
import Workbench from '../components/Workbench.astro';
import Ouroboros from '../components/Ouroboros.astro';
import SelfHosting from '../components/SelfHosting.astro';
import Contributions from '../components/Contributions.astro';
import EarlyYears from '../components/EarlyYears.astro';
---

<Base>
  <Wall />
  <Bar />
  <main class="desk" id="desk">
    <Hello />
    <Apps />
    <Gauges />
    <Tools />
    <Workbench />
    <Ouroboros />
    <SelfHosting />
    <Contributions />
    <EarlyYears />
  </main>
</Base>

<script>
  import { initDesktop } from '../scripts/desktop';
  import { initTerminals } from '../scripts/terminal';

  initTerminals();
  initDesktop();
</script>
