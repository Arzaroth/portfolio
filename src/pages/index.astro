<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="Arzaroth: apps, desktop tools, self-hosting and open source work.">
<title>Arzaroth</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;800;900&family=Schibsted+Grotesk:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap">
<script is:inline>document.documentElement.classList.add('js');</script>
<style is:global>
@property --glow { syntax: '<color>'; inherits: true; initial-value: transparent; }
:root {
  --bg: #dde0e5;
  --paper: #eceef1;
  --ink: #111418;
  --muted: #535b67;
  --rule: #bcc2cb;
  --room: #161a20;
  --room-ink: #e3e6eb;
  --room-muted: #7f8898;
  --steel: #0c0e11;
  --steel-2: #262b33;
  --steel-3: #353b45;
  --steel-ink: #dde1e7;
  --steel-muted: #8790a0;
  --c-cyan: #0e93a8;
  --c-blue: #2358e8;
  --c-yellow: #d9a400;
  --c-green: #178a4c;
  --c-red: #d3263a;
  --c-magenta: #c42a86;
  --c-orange: #e8720c;
  --c-grey: #7d8694;
  --led: #37e07a;
  --led-old: #ffd02a;
  --display: "Big Shoulders Display", "Arial Narrow", Impact, sans-serif;
  --body: "Schibsted Grotesk", system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
  --u: clamp(8px, calc((100vh - 250px) / 43), 14px);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --bg: #111418;
    --paper: #181c22;
    --ink: #e7eaee;
    --muted: #98a1ae;
    --rule: #2b313a;
    --room: #08090c;
    --room-ink: #e3e6eb;
    --room-muted: #7a8394;
    --steel: #000000;
    --steel-2: #1d2128;
    --steel-3: #2b3038;
    --c-cyan: #3fd0e3;
    --c-blue: #5b86ff;
    --c-yellow: #f2c230;
    --c-green: #35c276;
    --c-red: #ff5468;
    --c-magenta: #ff6bbd;
    --c-orange: #ff9a3d;
    --c-grey: #9aa3b1;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #111418;
  --paper: #181c22;
  --ink: #e7eaee;
  --muted: #98a1ae;
  --rule: #2b313a;
  --room: #08090c;
  --room-ink: #e3e6eb;
  --room-muted: #7a8394;
  --steel: #000000;
  --steel-2: #1d2128;
  --steel-3: #2b3038;
  --c-cyan: #3fd0e3;
  --c-blue: #5b86ff;
  --c-yellow: #f2c230;
  --c-green: #35c276;
  --c-red: #ff5468;
  --c-magenta: #ff6bbd;
  --c-orange: #ff9a3d;
  --c-grey: #9aa3b1;
}

* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--body);
  font-size: 17px;
  line-height: 1.6;
}
a { color: inherit; }
p { margin: 0; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--c, var(--c-blue)); outline-offset: 3px; border-radius: 2px; }

.app { display: grid; grid-template-columns: 400px minmax(0, 1fr); min-height: 100vh; }

/* ---------- the server room ---------- */
.side {
  position: sticky;
  top: 0;
  height: 100vh;
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 28px 30px 22px;
  color: var(--room-ink);
  background:
    radial-gradient(ellipse 90% 45% at 55% var(--gy, 20%), color-mix(in srgb, var(--glow) 26%, transparent), transparent 70%),
    var(--room);
  transition: --glow .6s ease;
  z-index: 2;
  min-width: 0;
}
.side::after {
  content: ""; position: absolute; top: 0; bottom: 0; right: -2px; width: 3px; pointer-events: none;
  background: radial-gradient(ellipse 100% 9% at 50% var(--gy, 20%), var(--glow), transparent);
  filter: blur(1px);
}
.brand { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
.brand b { font-family: var(--display); font-weight: 900; font-size: 34px; line-height: 1; letter-spacing: .01em; }
.brand span { font-size: 13px; color: var(--room-muted); }
.rack-zone { flex: 1; display: flex; align-items: center; gap: 16px; min-height: 0; position: relative; }
.rack-zone .rack { flex: 1; min-width: 0; }
.rack {
  width: 100%;
  background: var(--steel);
  border-radius: 6px 6px 3px 3px;
  padding: 12px 10px 16px;
  box-shadow: 0 0 0 1px rgba(255,255,255,.05), 0 40px 60px -30px #000;
  position: relative;
}
.rack-top { display: flex; justify-content: space-between; align-items: center; font-family: var(--mono); font-size: 11px; color: var(--steel-muted); padding: 0 4px 9px; }
.rack-top b { font-weight: 500; color: var(--steel-ink); }
.pwr { display: inline-flex; align-items: center; gap: 6px; }
.pwr i { width: 6px; height: 6px; border-radius: 50%; background: var(--led); box-shadow: 0 0 6px var(--led); }
.bay {
  display: grid;
  grid-template-columns: 20px minmax(0, 1fr) 20px;
  grid-template-rows: repeat(42, var(--u));
  column-gap: 4px;
}
.un {
  grid-column: 1;
  font-family: var(--mono); font-size: 8px; line-height: var(--u);
  color: var(--steel-muted); text-align: right; opacity: .8;
  font-variant-numeric: tabular-nums;
  border-top: 1px solid rgba(255,255,255,.04);
  overflow: hidden;
}
.un.r { grid-column: 3; text-align: left; }
.rail {
  grid-column: 2; grid-row: 1 / -1;
  background:
    radial-gradient(circle at 5px 50%, #000 1.3px, transparent 1.6px) left / 10px var(--u) repeat-y,
    radial-gradient(circle at 5px 50%, #000 1.3px, transparent 1.6px) right / 10px var(--u) repeat-y,
    repeating-linear-gradient(90deg, transparent 0 5px, rgba(255,255,255,.03) 5px 6px),
    var(--steel-2);
  border-radius: 2px;
}
.dev {
  grid-column: 2;
  grid-row: var(--r);
  position: relative;
  z-index: 1;
  margin: 1px 0;
  display: flex; align-items: center; gap: 8px;
  padding: 0 10px 0 16px;
  background: linear-gradient(180deg, var(--steel-3), var(--steel-2));
  border: 0;
  border-radius: 2px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.07), 0 1px 0 rgba(0,0,0,.5);
  text-decoration: none;
  color: var(--steel-ink);
  font-family: var(--display); font-weight: 800;
  font-size: min(15px, calc(var(--u) * 1.2));
  letter-spacing: .02em; line-height: 1;
  cursor: pointer;
  transition: background .25s, box-shadow .25s;
  animation: rackin .8s cubic-bezier(.2,.8,.2,1) both;
  animation-delay: calc(var(--i) * 80ms + 120ms);
}
.dev::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: var(--c); border-radius: 2px 0 0 2px; }
.dev .led {
  width: 5px; height: 5px; border-radius: 50%; flex: none;
  background: var(--ledc, var(--led)); box-shadow: 0 0 6px var(--ledc, var(--led));
  animation: power .5s steps(3) both, blink 3.4s steps(1) infinite;
  animation-delay: calc(var(--i) * 110ms + 900ms), calc(var(--i) * -.9s);
}
.dev .ports { margin-left: auto; display: flex; gap: 3px; }
.dev .ports i { width: 7px; height: 6px; background: #07080a; border-radius: 1px; box-shadow: inset 0 -2px 0 var(--c); }
.dev small { font-family: var(--mono); font-weight: 400; font-size: 9px; color: var(--steel-muted); letter-spacing: 0; }
.dev { overflow: hidden; }
.dev:hover { background: linear-gradient(180deg, #414853, var(--steel-3)); }
.dev::after {
  content: ""; position: absolute; top: 0; bottom: 0; left: -40%; width: 40%;
  background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--c) 45%, transparent), transparent);
  opacity: 0; pointer-events: none;
}
.dev.on {
  background: linear-gradient(180deg, #4b525e, #353b45);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.12), inset 0 0 0 1px color-mix(in srgb, var(--c) 70%, transparent), 0 0 18px -6px var(--c);
}
.dev.on::before { box-shadow: 0 0 10px 1px var(--c); }
.dev.on::after { animation: sweep .9s cubic-bezier(.4,0,.2,1) .05s; }
.dev.on .led { animation: activity .35s steps(1) infinite; animation-delay: 0s; }
.dev.on .ports i { box-shadow: inset 0 -2px 0 var(--c), 0 0 4px -1px var(--c); }
@keyframes sweep { 0% { left: -40%; opacity: 1; } 100% { left: 110%; opacity: 1; } }
@keyframes activity { 0% { opacity: 1; } 30% { opacity: .2; } 45% { opacity: 1; } 70% { opacity: .5; } }
@keyframes rackin { from { transform: translateX(120%); } }

.patchbar {
  position: relative; width: 16px; flex: none;
  background: var(--steel); border-radius: 3px;
  box-shadow: 0 0 0 1px rgba(255,255,255,.05);
}
.pport {
  position: absolute; left: 3px; width: 10px; height: 8px; margin-top: -4px;
  background: #000; border-radius: 1px;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.12);
  transition: box-shadow .3s, background .3s;
}
.pport.on { background: var(--pc); box-shadow: 0 0 10px 2px var(--pc); }
.wires { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; z-index: 2; }
.wires path { fill: none; stroke-linecap: round; }
.wires .w { stroke-width: 3.5; opacity: .5; transition: opacity .3s, stroke-width .3s; }
.wires .w.on { opacity: 1; stroke-width: 4.5; }
.wires .w.plug { stroke-dasharray: 400; stroke-dashoffset: 400; animation: draw .7s cubic-bezier(.5,0,.2,1) forwards; animation-delay: var(--dl, 0s); }
.wires .pk { stroke: #fff; stroke-width: 2; stroke-dasharray: 2 13; opacity: .9; animation: packets .6s linear infinite, fadein .4s 2.3s both; }
@keyframes fadein { from { opacity: 0; } }
.wires .shade { stroke: #000; stroke-width: 6; opacity: .35; }
@keyframes packets { to { stroke-dashoffset: -15; } }
@keyframes draw { to { stroke-dashoffset: 0; } }
@keyframes power { from { opacity: .1; box-shadow: none; } }
@keyframes blink { 0%, 86% { opacity: 1; } 88% { opacity: .25; } 91% { opacity: 1; } 94% { opacity: .35; } }
.side-foot { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; color: var(--room-muted); }
.side-foot a { color: var(--room-ink); text-underline-offset: 3px; }
.side-foot kbd { font-family: var(--mono); font-size: 11px; border: 1px solid #ffffff2a; border-bottom-width: 2px; border-radius: 3px; padding: 0 5px; color: var(--room-ink); }


/* ---------- stage ---------- */
.stage { padding: 56px 64px 80px 88px; min-width: 0; }
.pane { max-width: 900px; }
.js .pane[hidden] { display: none !important; }
.pane { --c: var(--c-blue); }
.pane + .pane { margin-top: 96px; }
.js .pane + .pane { margin-top: 0; }
.pane.leaving { opacity: 0; transform: translateX(-14px); transition: opacity .16s, transform .16s; }
.pane-head { position: relative; margin-bottom: 40px; }
.slot { font-family: var(--mono); font-size: 13px; color: var(--muted); display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
.slot::before { content: ""; width: 30px; height: 7px; border-radius: 4px; background: var(--c); }
.pane h2 {
  font-family: var(--display); font-weight: 900;
  font-size: clamp(48px, 7vw, 92px);
  line-height: 1.02; margin: 0 0 16px; padding-bottom: .05em;
  text-wrap: balance;
}
.lede { color: var(--muted); font-size: 19px; max-width: 36em; }

.rv { animation: rise .6s cubic-bezier(.2,.8,.2,1) both; animation-delay: calc(var(--k, 0) * 55ms + 120ms); }
@keyframes rise { from { opacity: 0; transform: translateY(18px); } }

/* about */
.hello-name {
  font-family: var(--display); font-weight: 900;
  font-size: clamp(88px, 13vw, 184px);
  line-height: .98; margin: 0 0 26px; padding-bottom: .04em;
  letter-spacing: -0.005em;
}
.hello-name span { display: inline-block; animation: drop .7s cubic-bezier(.2,.9,.2,1.2) both; animation-delay: calc(var(--n) * 45ms + 200ms); }
@keyframes drop { from { transform: translateY(-.35em) rotate(-4deg); opacity: 0; } }
.intro { max-width: 32em; display: grid; gap: 16px; }
.intro p:first-child { font-size: 24px; line-height: 1.4; font-weight: 500; text-wrap: pretty; }
.intro p + p { color: var(--muted); }
.elsewhere { display: flex; flex-wrap: wrap; gap: 8px 26px; margin-top: 28px; font-weight: 600; }
.elsewhere a { text-underline-offset: 4px; text-decoration-thickness: 1px; }
.elsewhere a:hover { text-decoration-thickness: 2px; }
.elsewhere span { font-family: var(--mono); font-size: 13px; color: var(--muted); font-weight: 400; margin-left: 6px; }
.index { margin-top: 56px; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 10px; }
.index button {
  all: unset; box-sizing: border-box; cursor: pointer;
  display: grid; grid-template-columns: 8px 1fr; gap: 2px 14px;
  padding: 14px 16px; border-radius: 4px;
  background: var(--paper);
  transition: transform .25s cubic-bezier(.2,.9,.2,1.2), box-shadow .25s;
}
.index button::before { content: ""; grid-row: span 2; border-radius: 4px; background: var(--c); }
.index b { font-family: var(--display); font-weight: 800; font-size: 22px; line-height: 1.15; }
.index small { color: var(--muted); font-size: 14px; line-height: 1.4; }
.index button:hover, .index button:focus-visible { transform: translateX(6px); box-shadow: -3px 0 0 var(--c); }

/* entries */
.entries { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 44px 40px; }
.entry { display: flex; flex-direction: column; gap: 10px; padding-top: 16px; border-top: 3px solid var(--c); position: relative; }
.entry h3 { font-family: var(--display); font-weight: 800; font-size: 34px; line-height: 1.08; margin: 0; padding-bottom: .04em; transition: transform .3s cubic-bezier(.2,.9,.2,1.2); }
.entry:hover h3 { transform: translateX(4px); }
.entry p { color: var(--muted); }
.meta { font-family: var(--mono); font-size: 12.5px; color: var(--muted); }
.links { display: flex; flex-wrap: wrap; gap: 6px 20px; font-weight: 600; font-size: 15px; margin-top: 2px; }
.links a { text-decoration-thickness: 1px; text-underline-offset: 4px; }
.links a:hover { color: var(--c); text-decoration-thickness: 2px; }
.wip {
  font-size: 12px; font-weight: 600; padding: 3px 10px; border-radius: 3px; color: #fff;
  background: repeating-linear-gradient(-45deg, var(--c-green) 0 8px, color-mix(in srgb, var(--c-green) 70%, #000) 8px 16px) 0 0 / 22.6px 22.6px;
  animation: barber 1.2s linear infinite;
}
@keyframes barber { to { background-position: 22.6px 0; } }

/* gauges + selvedge */
.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; }
.pair .entry { padding-bottom: 40px; }
.pair .entry::after {
  content: ""; position: absolute; left: 50%; bottom: 0; height: 40px; width: 2px;
  background: repeating-linear-gradient(180deg, var(--c-yellow) 0 5px, transparent 5px 10px) 0 0 / 2px 10px;
  animation: thread .8s linear infinite;
}
@keyframes thread { to { background-position: 0 10px; } }
.selvedge { position: relative; border-radius: 3px; background: var(--paper); padding: 32px 28px 26px; box-shadow: inset 0 0 0 2px var(--c-yellow); overflow: hidden; }
.selvedge::before {
  content: ""; position: absolute; left: 0; right: 0; top: 0; height: 12px;
  background:
    repeating-linear-gradient(135deg, var(--c-yellow) 0 4px, transparent 4px 8px),
    repeating-linear-gradient(45deg, var(--c-yellow) 0 4px, transparent 4px 8px);
  background-size: 11.3px 12px;
  opacity: .9;
  animation: weave 3s linear infinite;
}
@keyframes weave { to { background-position: 11.3px 0; } }
.selvedge-in { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 32px; }
.selvedge h3 { font-family: var(--display); font-weight: 800; font-size: 34px; line-height: 1.08; margin: 0 0 8px; padding-bottom: .04em; }
.selvedge p { color: var(--muted); }
.selvedge ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 15px; }
.selvedge li { display: flex; gap: 10px; align-items: baseline; }
.selvedge li::before { content: ""; width: 10px; height: 2px; background: var(--c-yellow); flex: none; transform: translateY(-4px); }
.lines-saved { font-family: var(--mono); font-size: 13px; color: var(--muted); margin-top: 14px; }
.lines-saved s { color: var(--c-red); }
.aside-gauge { margin-top: 52px; max-width: 36em; }

/* ouroboros */
.ouro { background: var(--room); color: var(--room-ink); border-radius: 4px; padding: 44px clamp(20px, 4vw, 52px) 48px; }
.ouro .lede { color: var(--room-ink); font-size: 20px; line-height: 1.5; }
.scale { margin-block: 40px 44px; display: grid; gap: 16px; }
.scale-row { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 16px; align-items: center; }
.scale-row b { font-family: var(--display); font-weight: 900; font-size: 34px; line-height: 1; font-variant-numeric: tabular-nums; display: block; }
.scale-row span { display: block; font-family: var(--mono); font-size: 11px; color: var(--room-muted); margin-top: 4px; }
.bar { height: 24px; background: var(--c-red); border-radius: 1px; transform-origin: left; }
.bar.tiny { width: max(2px, 0.032%); }
.bar.full { width: 100%; animation: grow 1.8s cubic-bezier(.5,0,.1,1) .35s both; }
@keyframes grow { from { transform: scaleX(.0003); } }
.tiers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 24px 32px; counter-reset: t -1; }
.tiers li { counter-increment: t; display: grid; grid-template-columns: 34px 1fr; gap: 4px 10px; font-size: 15px; color: var(--room-muted); }
.tiers li::before { content: counter(t); grid-row: span 2; font-family: var(--display); font-weight: 900; font-size: 32px; line-height: 1; color: var(--c-red); }
.tiers b { color: var(--room-ink); font-weight: 600; }
.ouro-foot { margin-top: 40px; display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: baseline; }
.ouro-foot p { color: var(--room-muted); font-style: italic; }
.ouro-foot a { color: var(--room-ink); font-weight: 600; text-underline-offset: 4px; }
.snake { width: 64px; height: 64px; float: right; margin: 6px 0 0 20px; }
.snake circle { fill: none; stroke: var(--c-red); stroke-width: 6; stroke-dasharray: 150 26; stroke-linecap: round; transform-origin: 32px 32px; animation: spin 6s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

/* self-hosting */
.patch { background: var(--room); border-radius: 4px; padding: 18px 20px 16px; margin-bottom: 48px; }
.patch-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(124px, 1fr)); gap: 10px 8px; }
.port { display: grid; grid-template-columns: 22px 1fr; gap: 8px; align-items: center; color: var(--room-ink); font-size: 13px; line-height: 1.2; }
.port i { width: 22px; height: 18px; border-radius: 2px; background: #000; box-shadow: inset 0 -5px 0 var(--pc, var(--c-magenta)), inset 0 0 0 1px rgba(255,255,255,.1); position: relative; }
.port i::after { content: ""; position: absolute; right: 3px; top: 3px; width: 3px; height: 3px; border-radius: 50%; background: var(--led); box-shadow: 0 0 4px var(--led); animation: traffic 1.3s steps(1) infinite; }
.port:nth-child(2n) i::after { animation-duration: .9s; }
.port:nth-child(3n) i::after { animation-duration: 1.7s; animation-delay: -.4s; }
.port:nth-child(5n) i::after { animation-duration: .6s; }
@keyframes traffic { 0%, 60% { opacity: 1; } 70% { opacity: .15; } 80% { opacity: 1; } 90% { opacity: .3; } }
.patch-foot { margin-top: 14px; padding-top: 10px; border-top: 1px solid rgba(255,255,255,.08); font-family: var(--mono); font-size: 11px; color: var(--room-muted); }

/* contributions */
.friends { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 40px; margin-bottom: 56px; }
.count { font-family: var(--display); font-weight: 900; font-size: 68px; line-height: 1; color: var(--c-orange); font-variant-numeric: tabular-nums; }
.count small { font-family: var(--body); font-size: 15px; font-weight: 500; color: var(--muted); margin-left: 8px; }
.upstream-wrap { overflow-x: auto; }
.upstream { width: 100%; border-collapse: collapse; }
.upstream caption { text-align: left; font-weight: 600; font-size: 15px; padding-bottom: 12px; }
.upstream td { padding: 13px 16px 13px 0; border-top: 1px solid var(--rule); vertical-align: baseline; }
.upstream tr:last-child td { border-bottom: 1px solid var(--rule); }
.upstream tr { transition: background .2s; }
.upstream tr:hover { background: color-mix(in srgb, var(--c-orange) 8%, transparent); }
.upstream td:first-child { font-weight: 600; white-space: nowrap; padding-left: 6px; }
.upstream td:first-child a { text-decoration: none; }
